# YouTube full-Short repost bot configuration
# Copy to .env. Never commit .env, OAuth files, cookies, tokens, logs, or DBs.

# Legacy single-account sources; named accounts use accounts.json.
TARGET_CHANNELS=""
FETCH_LIMIT_PER_CHANNEL=20
# How deep the channel listing scan goes (flat metadata only). The bot scans
# this window, applies the selected order (newest/oldest/random), then picks the
# FIRST Short that has NOT been uploaded yet - so already-posted Shorts are
# always skipped.
FETCH_SCAN_LIMIT=300
MAX_SHORTS_PER_CHANNEL_CYCLE=2
MAX_SHORT_DURATION_SEC=60
SELECTION_ORDER="newest"

# Processing
PROCESS_MODE="copy"
SHORT_ASPECT="9:16"
FILL_MODE="blur"
VIDEO_CRF=18
VIDEO_CRF_COPY=21
VIDEO_PRESET="medium"
AUDIO_BITRATE="192k"
FFMPEG_TIMEOUT_SEC=900
FFMPEG_PATH=""
FFPROBE_PATH=""

# Render-mode captions
# Subtitles ALWAYS follow the detected source language (never dubbed/translated).
# English-only models are auto-upgraded to multilingual; WHISPER_LANGUAGE is only
# a fallback when detection fails/uncertain. Subtitle style = one WHITE layer.
WHISPER_MODEL_SIZE="base"
WHISPER_LANGUAGE="auto"
MAX_WORDS_PER_SUBTITLE_LINE=4
SUBTITLE_STYLE_MODE="viral"
VIRAL_WORDS_PER_LINE=2
SUBTITLE_UPPERCASE=true
SUBTITLE_FONT_NAME=""
SUBTITLE_FONT_SIZE=28

# Render-mode music and overlays
BGM_ENABLED=true
BGM_VOLUME=0.18
VOICE_VOLUME=1.0
BGM_DIR="bgm"
LOGO_REMOVE_ENABLED=false
LOGO_POSITION="top-right"
LOGO_SIZE_PCT=12
LIKE_AND_SUBSCRIBE_ENABLED=true
LIKE_AND_SUBSCRIBE_TEXT="LIKE & SUBSCRIBE"
TOP_WATERMARK_ENABLED=true
TOP_WATERMARK_TEXT=""
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=56
TOP_WATERMARK_ITALIC=true
TOP_WATERMARK_Y_PCT=12
BOTTOM_BANNER_FONT_SIZE=56
BOTTOM_BANNER_OPACITY=1.0
BOTTOM_BANNER_ITALIC=true
BOTTOM_BANNER_Y_PCT=90

# Optional Cloudflare R2 backup
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="youtube-shorts-reposts"
R2_ENDPOINT_URL=""
R2_MAX_BUCKET_BYTES=8589934592

# Legacy single-account OAuth paths
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"
YOUTUBE_TOKEN_FILE="token.json"
MAX_DAILY_UPLOADS=10
DRY_RUN=false

# Scheduler/retention
CYCLE_INTERVAL_HOURS=3
KEEP_LOCAL_SHORTS=true
KEEP_SHORTS_DIR="finished_shorts"
DELETE_AFTER_UPLOAD=false
DELETE_R2_AFTER_UPLOAD=false

# Download authentication
YT_COOKIES_FILE=""
YT_COOKIES_FROM_BROWSER=""

# Paths
TEMP_DIR="temp_clips"
DB_PATH="bot_state.db"
LOG_FILE="shorts_repost.log"

# Web UI
WEBUI_HOST="127.0.0.1"
WEBUI_PORT=5100
WEBUI_USERNAME="admin"
WEBUI_PASSWORD=""
WEBUI_SECRET_KEY=""
WEBUI_COOKIE_SECURE=false

# Metadata compatibility settings; hashtags remain user-controlled.
ENABLE_SMART_TITLES=false
MAX_TITLE_HASHTAGS=4
REACH_HASHTAGS=""
EXTRA_HASHTAGS=""
TITLE_PREFIX=""
