# YouTube clip-farming bot configuration
# Copy to .env. Never commit .env, OAuth files, cookies, tokens, logs, or DBs.

# Source discovery (used only by legacy single-account mode; named accounts use accounts.json)
TARGET_CHANNELS=""
FETCH_LIMIT_PER_CHANNEL=5
# How deep the channel listing scan goes (flat metadata only). The bot scans
# this window, applies the selected order (newest/oldest/random), then picks the
# FIRST video that has NOT been uploaded yet - so already-posted videos are
# always skipped and it never gets stuck on the newest few.
FETCH_SCAN_LIMIT=300
# Per-request network timeout for yt-dlp (seconds). Prevents a stalled YouTube
# connection from hanging a cycle silently for minutes (looks frozen).
YTDL_SOCKET_TIMEOUT_SEC=25
CLIP_DURATION_SEC=18
HEATMAP_SMOOTH_WINDOW_SEC=18
SHORTS_PER_VIDEO=1
SELECTION_ORDER="newest"

# Moment selection: how the bot picks the best 15-20s part of a source video.
#   "combined" = blend YouTube "Most Replayed" heatmap with audio excitement
#                (loud + high-pitched voice + sudden bursts). Falls back to
#                whichever signal is available if one is missing.
#   "heatmap"  = Most Replayed only
#   "audio"    = loud/high-pitched voice moments only
SELECTION_STRATEGY="combined"
HEATMAP_WEIGHT=0.55
AUDIO_EXCITEMENT_WEIGHT=0.45
# Inside the audio-excitement score (0-1 each, need not sum to 1):
AUDIO_ENERGY_WEIGHT=0.45
AUDIO_PITCH_WEIGHT=0.35
AUDIO_FLUX_WEIGHT=0.20
# Tiny audio probes used for excitement analysis (never downloads the full video)
AUDIO_SAMPLE_SEC=5
MAX_AUDIO_SAMPLES=60

# Rendering
SHORT_ASPECT="3:4"
FILL_MODE="blur"
VIDEO_CRF=18
VIDEO_PRESET="medium"
AUDIO_BITRATE="192k"
FFMPEG_TIMEOUT_SEC=900
FFMPEG_PATH=""
FFPROBE_PATH=""

# Captions
# The bot NEVER dubs, translates or replaces the audio - the source audio is
# uploaded unchanged. Subtitles ALWAYS follow the language Whisper detects in
# the source audio (the bot burns them in that language). English-only models
# (tiny.en/base.en/small.en) are automatically switched to their multilingual
# equivalent because they cannot detect French/Vietnamese/Urdu and would burn
# English gibberish. WHISPER_LANGUAGE is only a FALLBACK when detection fails
# or is uncertain (confidence < 0.5) - it never forces English over a clear
# French/Vietnamese/etc. detection.
WHISPER_MODEL_SIZE="base"
WHISPER_LANGUAGE="auto"
# Upload content-language tag: "auto" (whisper-detected), "en"/"vi"/"ur" (force),
# or "off" (no tag). Tagging never changes the audio.
VIDEO_LANGUAGE="auto"
# Original audio track: on multi-language videos (official dubs) the bot always
# picks the ORIGINAL track - a louder/higher-bitrate dub never wins.
# Subtitle style is ONE WHITE layer (primary + secondary both white).
MAX_WORDS_PER_SUBTITLE_LINE=4
SUBTITLE_STYLE_MODE="viral"
VIRAL_WORDS_PER_LINE=2
SUBTITLE_UPPERCASE=true
SUBTITLE_FONT_NAME=""
SUBTITLE_FONT_SIZE=28

# Optional background music
BGM_ENABLED=true
BGM_VOLUME=0.18
VOICE_VOLUME=1.0
BGM_DIR="bgm"

# Optional source-logo blur
LOGO_REMOVE_ENABLED=false
LOGO_POSITION="top-right"
LOGO_SIZE_PCT=12

# Account text overlays
LIKE_AND_SUBSCRIBE_ENABLED=true
LIKE_AND_SUBSCRIBE_TEXT="LIKE & SUBSCRIBE"
TOP_WATERMARK_ENABLED=true
TOP_WATERMARK_TEXT=""
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=56
TOP_WATERMARK_ITALIC=true
TOP_WATERMARK_Y_PCT=12
BOTTOM_BANNER_FONT_SIZE=56
BOTTOM_BANNER_OPACITY=1.0
BOTTOM_BANNER_ITALIC=true
BOTTOM_BANNER_Y_PCT=90

# Optional Cloudflare R2 backup. Leave blank to skip R2 without simulating success.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="youtube-shorts-clips"
R2_ENDPOINT_URL=""
R2_MAX_BUCKET_BYTES=8589934592

# Legacy single-account OAuth paths. Named accounts use accounts/<safe-name>/.
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"
YOUTUBE_TOKEN_FILE="token.json"
MAX_DAILY_UPLOADS=10
# Explicit preview mode: prepares files but never records a YouTube upload/quota.
DRY_RUN=false

# Scheduler and retention
CYCLE_INTERVAL_HOURS=2
MIN_MINUTES_BETWEEN_UPLOADS=0
KEEP_LOCAL_SHORTS=true
KEEP_SHORTS_DIR="finished_shorts"
DELETE_AFTER_UPLOAD=false
DELETE_R2_AFTER_UPLOAD=false

# YouTube download authentication (optional)
YT_COOKIES_FILE=""
YT_COOKIES_FROM_BROWSER=""

# Paths
TEMP_DIR="temp_clips"
DB_PATH="bot_state.db"
LOG_FILE="shorts_bot.log"

# Web UI: local-only by default. A non-loopback bind requires WEBUI_PASSWORD.
WEBUI_HOST="127.0.0.1"
WEBUI_PORT=5000
WEBUI_USERNAME="admin"
WEBUI_PASSWORD=""
WEBUI_SECRET_KEY=""
WEBUI_COOKIE_SECURE=false

# Metadata compatibility settings. Published hashtags remain user-controlled.
ENABLE_SMART_TITLES=false
MAX_TITLE_HASHTAGS=4
REACH_HASHTAGS=""
EXTRA_HASHTAGS=""
TITLE_PREFIX=""
